<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.record_private.PrivateRecordActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content" >

        <ImageView
            android:id="@+id/back_button"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="56dp"
            android:layout_marginStart="32dp"
            android:contentDescription="@string/back_button"
            android:src="@drawable/back_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/record_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:fontFamily="@font/poppins_semi_bold"
            android:text="@string/record_activity"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:layout_constraintStart_toEndOf="@id/back_button"
            app:layout_constraintBottom_toBottomOf="@id/back_button"
            app:layout_constraintTop_toTopOf="@id/back_button" />

        <TextView
            android:id="@+id/type_activity"
            android:text="@string/type_activity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/TextLabel.BodyWhite"
            app:layout_constraintStart_toStartOf="@+id/back_button"
            app:layout_constraintTop_toBottomOf="@+id/back_button" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/category_option_layout"
            style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="32dp"
            app:boxCornerRadiusTopStart="18dp"
            app:boxCornerRadiusTopEnd="18dp"
            app:boxCornerRadiusBottomStart="18dp"
            app:boxCornerRadiusBottomEnd="18dp"
            app:errorEnabled="true"
            app:startIconDrawable="@drawable/activity_icon"
            app:startIconTint="@color/lime_green"
            app:boxBackgroundColor="@color/dark_gray_2"
            app:boxStrokeWidthFocused="0dp"
            app:boxStrokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@+id/type_activity"
            app:layout_constraintStart_toStartOf="@id/type_activity">

            <AutoCompleteTextView
                android:id="@+id/category_option"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/poppins_medium"
                android:textSize="12sp"
                android:padding="20dp"
                android:textColor="@color/white"
                android:inputType="none"
                app:simpleItems="@array/category_menu"
                tools:ignore="LabelFor" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/duration_question"
            style="@style/TextLabel.BodyWhite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:text="@string/activity_duration"
            app:layout_constraintStart_toStartOf="@id/type_activity"
            app:layout_constraintTop_toBottomOf="@+id/category_option_layout" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/InputField.RoundedIcon"
            android:id="@+id/durationTextField"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/activity_duration"
            app:startIconDrawable="@drawable/duration_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/duration_question"
            app:layout_constraintTop_toBottomOf="@+id/duration_question">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/duration_input"
                style="@style/EditText.WhiteInput"
                android:inputType="number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/continue_button"
            style="@style/RoundedGreenButton"
            android:layout_marginVertical="56dp"
            android:text="@string/start"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/durationTextField" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>