<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:layout_marginHorizontal="64dp"
    android:layout_marginVertical="84dp"
    android:background="@color/dark_gray_2">

    <TextView
        android:id="@+id/tutorial_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/skenario_rekam_aktivitas"
        android:textColor="@color/lime_green"
        android:fontFamily="@font/poppins_bold"
        android:textSize="18sp"
        android:gravity="center"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tutorial_image" />

    <ImageView
        android:id="@+id/tutorial_image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginVertical="24dp"
        android:contentDescription="@string/tutorial_message"
        android:src="@drawable/push_up_scenario"
        android:scaleType="fitCenter"
        app:layout_constraintTop_toBottomOf="@id/tutorial_title"
        app:layout_constraintBottom_toTopOf="@id/tutorial_message"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintDimensionRatio="16:9"/>

    <TextView
        android:id="@+id/tutorial_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_medium"
        android:textSize="14sp"
        android:textColor="@color/light_gray"
        android:layout_marginHorizontal="24dp"
        android:textAlignment="viewStart"
        android:text="@string/tutorial_message"
        app:layout_constraintBottom_toTopOf="@id/button_confirmation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tutorial_image"/>

    <Button
        android:id="@+id/button_confirmation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/understand"
        style="@style/RoundedGreenButton"
        android:layout_marginVertical="24dp"
        app:layout_constraintTop_toBottomOf="@id/tutorial_message"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>