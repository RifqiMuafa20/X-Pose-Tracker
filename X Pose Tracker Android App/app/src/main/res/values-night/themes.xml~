<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.XPoseTracker" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowActionModeOverlay">false</item>
        <item name="android:windowContentOverlay">@null</item>

        <!-- Primary brand color -->
        <item name="colorPrimary">@color/lime_green</item>
        <item name="colorPrimaryVariant">@color/lime_green</item>
        <item name="colorOnPrimary">@color/black</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/red_orange</item>
        <item name="colorSecondaryVariant">@color/red_orange</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Background dan status bar -->
        <item name="android:statusBarColor">@color/dark_gray_1</item>
        <item name="android:navigationBarColor">@color/dark_gray_2</item>

        <!-- Optional: background color app -->
        <item name="android:colorBackground">@color/dark_gray_1</item>
    </style>

    <style name="TextLabel">

    </style>

    <style name="EditText">

    </style>

    <style name="TextLabel.SmallGray">
        <item name="android:textColor">@color/medium_gray</item>
        <item name="android:fontFamily">@font/poppins_semi_bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:layout_marginStart">32dp</item>
        <item name="android:layout_marginTop">32dp</item>
    </style>

    <style name="TextLabel.HeadingWhite">
        <item name="android:layout_marginTop">32dp</item>
        <item name="android:fontFamily">@font/poppins_semi_bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="TextLabel.BodyWhite">
        <item name="android:layout_marginTop">32dp</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="InputField.RoundedIcon" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">18dp</item>
        <item name="boxCornerRadiusTopEnd">18dp</item>
        <item name="boxCornerRadiusBottomStart">18dp</item>
        <item name="boxCornerRadiusBottomEnd">18dp</item>
        <item name="startIconTint">@color/lime_green</item>
        <item name="startIconDrawable">@drawable/user_icon</item>
        <item name="errorEnabled">true</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginEnd">32dp</item>
        <item name="boxBackgroundColor">@color/dark_gray_2</item>
    </style>

    <style name="EditText.WhiteInput">
        <item name="android:backgroundTint">@color/dark_gray_2</item>
        <item name="android:fontFamily">@font/poppins_light</item>
        <item name="android:paddingStart">56dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="GenderToggleButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">16dp</item>
        <item name="fontFamily">@font/poppins_light</item>
        <item name="android:textSize">12sp</item>
        <item name="strokeColor">@color/white_50</item>
        <item name="strokeWidth">1dp</item>
        <item name="iconPadding">8dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="RoundedGreenButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:layout_marginStart">32dp</item>
        <item name="android:layout_marginEnd">32dp</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:background">@drawable/button_border</item>
    </style>
    <style name="Base.Theme.XPoseTracker" parent="Theme.Material3.DayNight.NoActionBar">

    </style>
</resources>
